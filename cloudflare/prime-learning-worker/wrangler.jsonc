{
  "name": "ergentics-prime-learning-dev",
  "account_id": "940705aeb10207356a9e0b2445bb06b6",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUN_STATE",
        "class_name": "PrimeLearningRun"
      }
    ]
  },
  "migrations": [
    {
      "tag": "prime-learning-run-v1",
      "new_sqlite_classes": [
        "PrimeLearningRun"
      ]
    }
  ],
  "workflows": [
    {
      "binding": "PILOT_WORKFLOW",
      "name": "ergentics-prime-learning-pilot",
      "class_name": "PrimeLearningWorkflow"
    }
  ],
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "vars": {
    "PILOT_ENABLED": "false",
    "PILOT_ROUTE_POLICY_ATTESTED": "false",
    "PILOT_DEFAULT_ALIAS_ATTESTED": "false",
    "PILOT_FALLBACK_DISABLED_ATTESTED": "false"
  }
}
